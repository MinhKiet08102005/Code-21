<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">
    <display-name>He thong quan li nha hang - De 21</display-name>

    <!-- Doc du lieu form theo UTF-8 cho moi trang -->
    <filter>
        <filter-name>encoding</filter-name>
        <filter-class>org.apache.catalina.filters.SetCharacterEncodingFilter</filter-class>
        <init-param>
            <param-name>encoding</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>encoding</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Hai trang xu ly co tai anh mon an (multipart) -->
    <servlet>
        <servlet-name>doSaveDish0</servlet-name>
        <jsp-file>/quanly/doSaveDish0.jsp</jsp-file>
        <multipart-config>
            <max-file-size>10485760</max-file-size>
            <max-request-size>12582912</max-request-size>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>doSaveDish0</servlet-name>
        <url-pattern>/quanly/doSaveDish0.jsp</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>doUpdateDish0</servlet-name>
        <jsp-file>/quanly/doUpdateDish0.jsp</jsp-file>
        <multipart-config>
            <max-file-size>10485760</max-file-size>
            <max-request-size>12582912</max-request-size>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>doUpdateDish0</servlet-name>
        <url-pattern>/quanly/doUpdateDish0.jsp</url-pattern>
    </servlet-mapping>

    <!-- Moi trang JSP: UTF-8, tu dong import cac goi model, dao, util -->
    <jsp-config>
        <jsp-property-group>
            <url-pattern>*.jsp</url-pattern>
            <url-pattern>*.jspf</url-pattern>
            <page-encoding>UTF-8</page-encoding>
            <include-prelude>/common/imports.jspf</include-prelude>
            <trim-directive-whitespaces>true</trim-directive-whitespaces>
            <default-content-type>text/html; charset=UTF-8</default-content-type>
        </jsp-property-group>
    </jsp-config>

    <session-config>
        <session-timeout>120</session-timeout>
    </session-config>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/common/error.jsp</location>
    </error-page>
</web-app>
